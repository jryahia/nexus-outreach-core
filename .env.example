# Copy to .env and fill in. .env is gitignored - never commit real credentials.

# --- Zoho SMTP -------------------------------------------------------------
ZOHO_SMTP_HOST=smtp.zoho.eu
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SSL=true

# Inbox rotation. Sends go round-robin across every mailbox listed here:
# lead 1 from the first, lead 2 from the second, and so on. Spreading volume
# is what keeps a single Zoho account under its sending limits.
#
#   ZOHO_ACCOUNTS="you@domain.com:apppass1,sales@domain.com:apppass2"
#
# Entries separate on a comma OR a newline, so this also works:
#
#   ZOHO_ACCOUNTS="you@domain.com:apppass1
#   sales@domain.com:apppass2"
#
# The email is split on the FIRST colon, so an app password containing a colon
# is safe. An optional display name goes after a pipe:
#
#   ZOHO_ACCOUNTS="you@domain.com:apppass1|Display Name"
#
# Use APP-SPECIFIC passwords from Zoho (Security > App Passwords), never your
# account password.
ZOHO_ACCOUNTS=

# Single-account fallback, used only when ZOHO_ACCOUNTS is empty.
ZOHO_EMAIL=you@yourdomain.com
ZOHO_APP_PASSWORD=

# Default display name for accounts that do not carry their own.
FROM_NAME=Your Name

# Where replies go if different from the sending mailbox.
REPLY_TO=

# --- Sending rhythm --------------------------------------------------------
# Gap between two sends, picked at random inside this range. 120-360 is the
# 2-6 minute human cadence.
MIN_DELAY_SECONDS=120
MAX_DELAY_SECONDS=360

# Coffee break: after this many sends, rest for a randomised stretch before
# resuming. Set COFFEE_BREAK_EVERY=0 to switch it off.
COFFEE_BREAK_EVERY=25
COFFEE_BREAK_MIN_SECONDS=900
COFFEE_BREAK_MAX_SECONDS=1500

# Hard stop on how many leads one campaign will touch.
DAILY_SEND_CAP=50

# Appended to every email body. Required by CAN-SPAM / GDPR for cold outreach.
UNSUBSCRIBE_LINE=Reply STOP and I will not contact you again.
POSTAL_ADDRESS=

# --- Scraping --------------------------------------------------------------
HEADLESS=true
REQUEST_TIMEOUT=30000

# Persistent browser profiles. TikTok blocks every logged-out request, so sign
# in once with tools/tiktok_login.py and point this at the folder it creates.
TIKTOK_PROFILE_DIR=
IG_PROFILE_DIR=
