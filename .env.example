# Copy to .env and fill in. .env is gitignored - never commit real credentials.

# --- Mailboxes -------------------------------------------------------------
# Every mailbox the campaign rotates through. Any SMTP provider works - Gmail,
# Zoho, Outlook, Fastmail or your own server - and they can be mixed freely,
# because each entry carries its own host, port and transport.
#
#   MAILBOXES="host:port:address:password"
#
# Entries separate on a comma OR a newline:
#
#   MAILBOXES="smtp.gmail.com:587:you@gmail.com:abcd efgh ijkl mnop,
#              smtp.zoho.eu:465:hello@yourdomain.com:app-password"
#
# Port decides the transport. 465 opens an SSL connection directly; 587 (and
# 25, 2525) connect first and upgrade with STARTTLS. Providers do not
# negotiate this - the wrong port looks like a timeout, not a config error.
#
#   Gmail        smtp.gmail.com:587          Zoho EU   smtp.zoho.eu:465
#   Outlook      smtp-mail.outlook.com:587   Zoho COM  smtp.zoho.com:465
#   Yahoo        smtp.mail.yahoo.com:465     iCloud    smtp.mail.me.com:587
#
# A short form is also accepted, and looks the provider up from the address:
#
#   MAILBOXES="you@gmail.com:abcd efgh ijkl mnop"
#
# Only the address and the password are split on the first colons, so a
# password containing a colon survives intact. An optional display name goes
# after a pipe:
#
#   MAILBOXES="smtp.gmail.com:587:you@gmail.com:app-password|Display Name"
#
# Use APP-SPECIFIC passwords, never your account password. Gmail needs 2-Step
# Verification switched on before it will issue one.
MAILBOXES=

# Fallback endpoint for a short entry whose domain is not a known provider -
# your own mail server, for instance.
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465

# Single-mailbox fallback, used only when MAILBOXES is empty.
SMTP_EMAIL=
SMTP_PASSWORD=

# Default display name for mailboxes that do not carry their own.
FROM_NAME=Your Name

# Where replies go if different from the sending mailbox.
REPLY_TO=

# --- Sending rhythm --------------------------------------------------------
# Gap between two sends, picked at random inside this range. 120-360 is the
# 2-6 minute human cadence.
MIN_DELAY_SECONDS=120
MAX_DELAY_SECONDS=360

# Coffee break: after this many sends, rest for a randomised stretch before
# resuming. Set COFFEE_BREAK_EVERY=0 to switch it off.
COFFEE_BREAK_EVERY=25
COFFEE_BREAK_MIN_SECONDS=900
COFFEE_BREAK_MAX_SECONDS=1500

# Hard stop on how many leads one campaign will touch.
DAILY_SEND_CAP=50

# Appended to every email body. Required by CAN-SPAM / GDPR for cold outreach.
UNSUBSCRIBE_LINE=Reply STOP and I will not contact you again.
POSTAL_ADDRESS=

# --- The Outpost: webhooks out to your automation --------------------------
# When set, operational events are POSTed here as JSON so an n8n, GoHighLevel
# or WhatsApp flow can relay a live feed to your phone. Leave it empty and
# nothing ever leaves this machine.
#
# Events: campaign.started, email.sent, email.failed, email.skipped,
#         campaign.finished, hunt.finished
#
# Treat this URL as a credential - n8n and GoHighLevel both put an auth token
# in the path. It is never logged and never shown in the UI.
NEXUS_WEBHOOK_URL=

# Off by default, and deliberately so. The standard payload carries counters
# and status only. Switch this on and the addresses, names and subject lines of
# scraped third parties are sent to the endpoint above as well.
NEXUS_WEBHOOK_DETAIL=false

# --- Ghost Protocol --------------------------------------------------------
# The proxy Ghost Protocol routes through when engaged. Without it, Ghost still
# blocks WebRTC local-address leaks and trims the fingerprint, but requests
# leave from this machine's own IP address.
#
#   NEXUS_PROXY="http://user:password@host:port"
#
# A residential pool is a comma-separated list, rotated round-robin with one
# exit address per request:
#
#   NEXUS_PROXY="http://u:p@a.provider:8000,http://u:p@b.provider:8000"
#
# Ghost also retries a 403, 429 or 503 with an exponential backoff, taking the
# next proxy each time, instead of reporting the block as "no results found".
NEXUS_PROXY=

# --- Scraping --------------------------------------------------------------
HEADLESS=true
REQUEST_TIMEOUT=30000

# Persistent browser profiles. TikTok blocks every logged-out request, so sign
# in once with tools/tiktok_login.py and point this at the folder it creates.
TIKTOK_PROFILE_DIR=
IG_PROFILE_DIR=
